# Front end (safe in the browser)
VITE_KID_PUBLISHABLE_KEY=

# Back end only: set these in Vercel → Settings → Environment Variables. Never commit real values.
KID_SECRET_KEY=
INWORLD_API_KEY=
MODULATE_API_KEY=
FASTSPRING_WEBHOOK_SECRET=

# Ollie's voices (Inworld). Pick voice IDs in Inworld's TTS Playground. Teen and adult only (Ollie doesn't speak to kids). Without one, the browser's voice is used.
INWORLD_VOICE_TEEN=
INWORLD_VOICE_ADULT=
# INWORLD_MODEL=inworld-tts-2

# Ask Ollie answers (Google Gemini, free tier from aistudio.google.com). Without it, Ollie uses keyword answers.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
